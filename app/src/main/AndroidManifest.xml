<?xml version="1.0" encoding="utf-8"?>
<!--
  [X-custom] 应用名按渠道取值:标签由 build.gradle.kts 的 x.channel 决定,
  nightly 渠道指向 app_name_nightly(桌面显示 `RikkaHub X Nightly`)。
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:tools="http://schemas.android.com/tools">

  <uses-permission android:name="android.permission.INTERNET" />
  <uses-permission android:name="android.permission.CAMERA" />
  <uses-permission android:name="android.permission.RECORD_AUDIO" />
  <uses-permission
    android:name="android.permission.WRITE_EXTERNAL_STORAGE"
    android:maxSdkVersion="28" />
  <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
  <uses-permission android:name="android.permission.POST_PROMOTED_NOTIFICATIONS" />
  <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
  <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
  <uses-permission android:name="android.permission.ACCESS_LOCAL_NETWORK" />
  <uses-permission
    android:name="android.permission.PACKAGE_USAGE_STATS"
    tools:ignore="ProtectedPermissions" />
  <uses-permission android:name="android.permission.READ_CALENDAR" />
  <uses-permission android:name="android.permission.WRITE_CALENDAR" />

  <!--
    [X-custom] 移除依赖带入的广告 ID 权限(2026-09-13)。

    上游源码**没有**声明这三条:它们是 manifest 合并时由
    `play-services-measurement-impl` / `play-services-measurement-api`
    (firebase-analytics 的传递依赖)带进来的。本应用不做广告、不做归因,
    自签分发的 APK 里挂着「读取广告 ID」的权限与定位不符。

    用 `tools:node="remove"` 在合并阶段删掉,而不是去 exclude 依赖 ——
    删依赖会让 `Firebase.analytics` 的 Koin 注册在启动时崩
    (那属于「方案 B」,要同时改代码)。
  -->
  <uses-permission
    android:name="com.google.android.gms.permission.AD_ID"
    tools:node="remove" />
  <uses-permission
    android:name="android.permission.ACCESS_ADSERVICES_ATTRIBUTION"
    tools:node="remove" />
  <uses-permission
    android:name="android.permission.ACCESS_ADSERVICES_AD_ID"
    tools:node="remove" />

  <uses-feature
    android:name="android.hardware.camera"
    android:required="false" />
  <uses-feature
    android:name="android.hardware.camera.autofocus"
    android:required="false" />

  <queries>
    <intent>
      <action android:name="android.intent.action.TTS_SERVICE" />
    </intent>
    <!-- 用于解析屏幕使用时间里各 App 的名称(可见性受 Android 11+ 包可见性限制) -->
    <intent>
      <action android:name="android.intent.action.MAIN" />
      <category android:name="android.intent.category.LAUNCHER" />
    </intent>
    <!-- 用于识别桌面 launcher 以便在屏幕使用时间中排除 -->
    <intent>
      <action android:name="android.intent.action.MAIN" />
      <category android:name="android.intent.category.HOME" />
    </intent>
  </queries>

  <application
    android:name=".RikkaHubApp"
    android:largeHeap="true"
    android:allowBackup="true"
    android:appCategory="productivity"
    android:dataExtractionRules="@xml/data_extraction_rules"
    android:enableOnBackInvokedCallback="true"
    android:fullBackupContent="@xml/backup_rules"
    android:icon="@mipmap/ic_launcher"
    android:label="${appLabel}"
    android:supportsRtl="true"
    android:theme="@style/Theme.Rikkahub"
    android:usesCleartextTraffic="true"
    tools:targetApi="33">

    <!--
      [X-custom] 关闭 Google 统计的**数据采集**(2026-09-13)。

      ## 为什么关

      上游只埋了 5 个**无参**事件(全在 ChatVM,`ai_send_message` 之类),对自用 fork
      没有任何决策价值;依赖却会带进广告 ID 权限(见上面的 remove 段)。
      X 自己的诊断框架(`x/diag`)已经能给出更贴需求的现场,且是本地落盘 + 可导出。

      ## 这两条各管什么

      · `firebase_analytics_collection_enabled` —— GA4 采集总开关。
      · `firebase_crashlytics_collection_enabled` —— Crashlytics 在
        `FirebaseInitProvider` 初始化时**默认 true**,故必须显式置 false
        (`CrashlyticsInitProvider` 读的正是这一条)。置 false 后 SDK 推迟到
        `setCrashlyticsCollectionEnabled(true)` 才启用 —— 而本应用从不调用它。

      ## 实测依据(2026-09-13 真机日志)

      `E FirebaseCrashlytics: Settings request failed.`
      `java.io.FileNotFoundException: https://firebase-settings.crashlytics.com/.../1:000000000000:...`
      —— 即便用的是**全 0 占位的 google-services.json**,Crashlytics 照样初始化、
      照样往外发请求(拿到 404 才没送出去,但 12 行噪声与一次外网往返是实打实的)。

      ## 只关采集,不动「能力」

      依赖、插件、`FirebaseInitProvider`、`AppModule` 的 Koin 注册**一律保留**:
      `Firebase.analytics` 是 lazy 注册而 ChatVM 构造时会 `get()` 它,
      若把 provider 一并 remove,每次打开会话会抛
      `IllegalStateException: Default FirebaseApp is not initialized`。
      将来要接自家 Firebase 做崩溃收集,删掉这两条 meta-data 即可恢复。
    -->
    <meta-data
      android:name="firebase_analytics_collection_enabled"
      android:value="false" />
    <meta-data
      android:name="firebase_crashlytics_collection_enabled"
      android:value="false" />

    <activity
      android:name=".ui.activity.SafeModeActivity"
      android:exported="false"
      android:label="@string/title_activity_safe_mode"
      android:theme="@style/Theme.Rikkahub" />
    <activity
      android:name=".RouteActivity"
      android:configChanges="keyboardHidden|orientation|screenSize"
      android:exported="true"
      android:importantForAutofill="noExcludeDescendants"
      android:theme="@style/Theme.Rikkahub"
      android:windowSoftInputMode="adjustResize">
      <intent-filter>
        <action android:name="android.intent.action.MAIN" />

        <category android:name="android.intent.category.LAUNCHER" />
      </intent-filter>
      <intent-filter>
        <action android:name="android.intent.action.SEND" />

        <category android:name="android.intent.category.DEFAULT" />

        <data android:mimeType="text/plain" />
      </intent-filter>
      <intent-filter>
        <action android:name="android.intent.action.PROCESS_TEXT" />

        <category android:name="android.intent.category.DEFAULT" />

        <data android:mimeType="text/plain" />
      </intent-filter>

      <intent-filter>
        <action android:name="me.rerere.rikkahub.action.TRANSLATE" />
        <category android:name="android.intent.category.DEFAULT" />
      </intent-filter>

      <meta-data
        android:name="android.app.shortcuts"
        android:resource="@xml/shortcuts" />
    </activity>
    <activity
      android:name=".ui.activity.ShortcutHandlerActivity"
      android:exported="true"
      android:theme="@android:style/Theme.Translucent.NoTitleBar">
      <intent-filter>
        <action android:name="android.intent.action.VIEW" />

        <category android:name="android.intent.category.DEFAULT" />

        <data
          android:host="shortcut"
          android:scheme="rikkahub" />
      </intent-filter>
    </activity>
    <activity
      android:name="com.yalantis.ucrop.UCropActivity"
      android:theme="@style/Theme.AppCompat.Light.NoActionBar" />

    <service
      android:name=".service.ChatGenerationForegroundService"
      android:exported="false"
      android:foregroundServiceType="dataSync" />
    <service
      android:name=".service.WebServerService"
      android:exported="false"
      android:foregroundServiceType="specialUse">
      <property
        android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
        android:value="local web server for LLM chat UI" />
    </service>

    <provider
      android:name="androidx.core.content.FileProvider"
      android:authorities="${applicationId}.fileprovider"
      android:exported="false"
      android:grantUriPermissions="true">
      <meta-data
        android:name="android.support.FILE_PROVIDER_PATHS"
        android:resource="@xml/file_paths" />
    </provider>
    <provider
      android:name=".data.provider.WorkspaceDocumentsProvider"
      android:authorities="${applicationId}.documents"
      android:exported="true"
      android:grantUriPermissions="true"
      android:permission="android.permission.MANAGE_DOCUMENTS">
      <intent-filter>
        <action android:name="android.content.action.DOCUMENTS_PROVIDER" />
      </intent-filter>
    </provider>
    <provider
      android:name="androidx.startup.InitializationProvider"
      android:authorities="${applicationId}.androidx-startup"
      android:exported="false"
      tools:node="merge">
      <meta-data
        android:name="androidx.work.WorkManagerInitializer"
        android:value="androidx.startup"
        tools:node="remove" />
    </provider>
  </application>

</manifest>
