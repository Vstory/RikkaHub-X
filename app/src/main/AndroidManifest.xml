<?xml version="1.0" encoding="utf-8"?>
<!--
  [X-custom] 应用名按渠道取值:标签由 build.gradle.kts 的 x.channel 决定,
  nightly 渠道指向 app_name_nightly(桌面显示 `RikkaHub X Nightly`)。
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:tools="http://schemas.android.com/tools">

  <uses-permission android:name="android.permission.INTERNET" />
  <uses-permission android:name="android.permission.CAMERA" />
  <uses-permission android:name="android.permission.RECORD_AUDIO" />
  <uses-permission
    android:name="android.permission.WRITE_EXTERNAL_STORAGE"
    android:maxSdkVersion="28" />
  <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
  <uses-permission android:name="android.permission.POST_PROMOTED_NOTIFICATIONS" />
  <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
  <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
  <uses-permission android:name="android.permission.ACCESS_LOCAL_NETWORK" />
  <uses-permission
    android:name="android.permission.PACKAGE_USAGE_STATS"
    tools:ignore="ProtectedPermissions" />
  <uses-permission android:name="android.permission.READ_CALENDAR" />
  <uses-permission android:name="android.permission.WRITE_CALENDAR" />

  <!--
    [X-custom] 移除依赖带入的广告 ID 权限(2026-09-13)。

    上游源码**没有**声明这三条:它们是 manifest 合并时由
    `play-services-measurement-impl` / `play-services-measurement-api`
    (firebase-analytics 的传递依赖)带进来的。本应用不做广告、不做归因,
    自签分发的 APK 里挂着「读取广告 ID」的权限与定位不符。

    ⚠️ **2026-09-13 更新**:Firebase 的运行时依赖已移除(见下面那段),故这三条**当前**
    已没有来源。但**刻意保留**:将来别的依赖把广告 ID 权限带回来时,这三条仍然把它摘掉
    —— 而那种回归是**看不清**的(装的时候不会提示,只有看 APK 权限或装机时的权限列表
    才发现)。留着它的代价为零,漏了它的代价是一次静默回归。
  -->
  <uses-permission
    android:name="com.google.android.gms.permission.AD_ID"
    tools:node="remove" />
  <uses-permission
    android:name="android.permission.ACCESS_ADSERVICES_ATTRIBUTION"
    tools:node="remove" />
  <uses-permission
    android:name="android.permission.ACCESS_ADSERVICES_AD_ID"
    tools:node="remove" />

  <uses-feature
    android:name="android.hardware.camera"
    android:required="false" />
  <uses-feature
    android:name="android.hardware.camera.autofocus"
    android:required="false" />

  <queries>
    <intent>
      <action android:name="android.intent.action.TTS_SERVICE" />
    </intent>
    <!-- 用于解析屏幕使用时间里各 App 的名称(可见性受 Android 11+ 包可见性限制) -->
    <intent>
      <action android:name="android.intent.action.MAIN" />
      <category android:name="android.intent.category.LAUNCHER" />
    </intent>
    <!-- 用于识别桌面 launcher 以便在屏幕使用时间中排除 -->
    <intent>
      <action android:name="android.intent.action.MAIN" />
      <category android:name="android.intent.category.HOME" />
    </intent>
  </queries>

  <application
    android:name=".RikkaHubApp"
    android:largeHeap="true"
    android:allowBackup="true"
    android:appCategory="productivity"
    android:dataExtractionRules="@xml/data_extraction_rules"
    android:enableOnBackInvokedCallback="true"
    android:fullBackupContent="@xml/backup_rules"
    android:icon="@mipmap/ic_launcher"
    android:label="${appLabel}"
    android:supportsRtl="true"
    android:theme="@style/Theme.Rikkahub"
    android:usesCleartextTraffic="true"
    tools:targetApi="33">

    <!--
      [X-custom] Firebase 的**运行时**已移除(2026-09-13)。

      ## 这里原来有什么

      两条 `firebase_*_collection_enabled=false` 的 meta-data —— 当时它们**只关采集、
      不动能力**(依赖、插件、`FirebaseInitProvider`、Koin 注册都保留),因为
      `Firebase.analytics` 是 Koin 注册而 ChatVM 构造时会取它。再往前还有
      Crashlytics 的对外请求(实测抓到的 404 噪声与一次外网往返)。

      ## 为什么现在能整个删掉:接替件**已在真机上验过**

      ⚠️ 三处注意:XML 注释里**不能出现连续两个短横**,故这里不用 markdown 表格
      (它的分隔行正是那种字符) —— 实测踩到过,报错是「not well-formed」。

      · 崩溃的 Java 栈 → `XCrashReport`(读回上游 CrashHandler 存的栈)
        证据:`survivors.log` 里有完整栈,栈底是 `ActivityThread.main`
      · **ANR** / 原生崩溃 / 被系统杀 → `XExitReport`(读系统 `ApplicationExitInfo`)
        证据:`diag.anr.detected`,带 `Input dispatching timed out`
      · 那 5 个使用计数 → chat 域的 `XChatEvents`
        证据:诊断页「事件」区可搜

      验证方式:自检里**故意造一次崩溃** + **故意造一次 ANR**,两条都在
      `survivors.log` 里,且**跨会话保留**(横跨两次重启)。

      ## ⚠️ 注意:「运行时」而不是「全部」—— **扫码库还带着 4 个 firebase helper jar**

      实测(e2382382 的产物):包内仍有 `firebase-annotations` / `firebase-components` /
      `firebase-encoders` / `firebase-encoders-json`,且 manifest 里有 6 处
      `com.google.firebase.components:…BarcodeRegistrar` —— **都是合法的**:
      它们来自**扫码库**(`com.google.mlkit:barcode-scanning` 传递依赖那几个 helper)。
      ML Kit 有**自己的**引导链(`MlKitInitProvider` + `MlKitComponentDiscoveryService`),
      只是**借用** firebase-components 的组件系统,**不需要** firebase-common。

      所以判据是「没有 Firebase **运行时**」而不是「没有 firebase 字样」:
      · 运行时(App / provider / analytics / crashlytics)→ **必须在不在**
        (`FirebaseApp` / `FirebaseInitProvider` / `ComponentDiscoveryService` 三个类名在 dex 里为 0);
      · ML Kit 的 helper → 允许存在。

      三层守卫覆盖这件事:`check_x_manifest.py`(构建文件/Manifest/Kotlin import)、
      daily-build 的 `Assert no Firebase runtime in the APK`(产物级,用
      `scripts/check_x_apk_no_firebase_runtime.py`)。

      ## ⚠️ 与上游合并时的注意

      **上游若把 Firebase 加回来,这里会跟着回来** —— 上面两个检查器会报。
      要真接自家 Firebase,先改它们的判据。
    -->

    <activity
      android:name=".ui.activity.SafeModeActivity"
      android:exported="false"
      android:label="@string/title_activity_safe_mode"
      android:theme="@style/Theme.Rikkahub" />
    <activity
      android:name=".RouteActivity"
      android:configChanges="keyboardHidden|orientation|screenSize"
      android:exported="true"
      android:importantForAutofill="noExcludeDescendants"
      android:theme="@style/Theme.Rikkahub"
      android:windowSoftInputMode="adjustResize">
      <intent-filter>
        <action android:name="android.intent.action.MAIN" />

        <category android:name="android.intent.category.LAUNCHER" />
      </intent-filter>
      <intent-filter>
        <action android:name="android.intent.action.SEND" />

        <category android:name="android.intent.category.DEFAULT" />

        <data android:mimeType="text/plain" />
      </intent-filter>
      <intent-filter>
        <action android:name="android.intent.action.PROCESS_TEXT" />

        <category android:name="android.intent.category.DEFAULT" />

        <data android:mimeType="text/plain" />
      </intent-filter>

      <intent-filter>
        <action android:name="me.rerere.rikkahub.action.TRANSLATE" />
        <category android:name="android.intent.category.DEFAULT" />
      </intent-filter>

      <meta-data
        android:name="android.app.shortcuts"
        android:resource="@xml/shortcuts" />
    </activity>
    <activity
      android:name=".ui.activity.ShortcutHandlerActivity"
      android:exported="true"
      android:theme="@android:style/Theme.Translucent.NoTitleBar">
      <intent-filter>
        <action android:name="android.intent.action.VIEW" />

        <category android:name="android.intent.category.DEFAULT" />

        <data
          android:host="shortcut"
          android:scheme="rikkahub" />
      </intent-filter>
    </activity>
    <activity
      android:name="com.yalantis.ucrop.UCropActivity"
      android:theme="@style/Theme.AppCompat.Light.NoActionBar" />

    <service
      android:name=".service.ChatGenerationForegroundService"
      android:exported="false"
      android:foregroundServiceType="dataSync" />
    <service
      android:name=".service.WebServerService"
      android:exported="false"
      android:foregroundServiceType="specialUse">
      <property
        android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
        android:value="local web server for LLM chat UI" />
    </service>

    <provider
      android:name="androidx.core.content.FileProvider"
      android:authorities="${applicationId}.fileprovider"
      android:exported="false"
      android:grantUriPermissions="true">
      <meta-data
        android:name="android.support.FILE_PROVIDER_PATHS"
        android:resource="@xml/file_paths" />
    </provider>
    <provider
      android:name=".data.provider.WorkspaceDocumentsProvider"
      android:authorities="${applicationId}.documents"
      android:exported="true"
      android:grantUriPermissions="true"
      android:permission="android.permission.MANAGE_DOCUMENTS">
      <intent-filter>
        <action android:name="android.content.action.DOCUMENTS_PROVIDER" />
      </intent-filter>
    </provider>
    <provider
      android:name="androidx.startup.InitializationProvider"
      android:authorities="${applicationId}.androidx-startup"
      android:exported="false"
      tools:node="merge">
      <meta-data
        android:name="androidx.work.WorkManagerInitializer"
        android:value="androidx.startup"
        tools:node="remove" />
    </provider>
  </application>

</manifest>
